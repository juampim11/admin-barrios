# ============================================================
# admin-barrios — variables de entorno (infraestructura local)
# Copiar a .env (para docker-compose) y a .env.local (para la app, cuando exista).
# NUNCA commitear .env ni .env.local.
# Ver docs/arquitectura/00-stack-infra.md para el porqué de cada abstracción.
# ============================================================

# --- Postgres (datos, ver ADR §3.1) ---
POSTGRES_DB=admin_barrios
POSTGRES_USER=admin_barrios
POSTGRES_PASSWORD=admin_barrios_dev
POSTGRES_PORT=5432

# Conexión de MIGRACIONES/administración (dueño del esquema). No la usa la app en runtime.
DATABASE_URL=postgres://admin_barrios:admin_barrios_dev@localhost:5432/admin_barrios

# Conexión de REQUEST: rol sujeto a RLS (doc 03 §A.5). Es la que usa la app para atender usuarios.
# Se crea localmente con `pnpm db:setup` (los roles nacen sin contraseña en la migración: un
# secreto nunca va al repo).
APP_DB_USER=app_request_dev
APP_DB_PASSWORD=app_request_dev
DATABASE_URL_APP=postgres://app_request_dev:app_request_dev@localhost:5432/admin_barrios

# Conexión de JOBS: rol con BYPASSRLS. Solo server-side (ingestas multi-barrio, reprocesos).
# NUNCA se expone al cliente ni se usa para atender un request de usuario.
JOB_DB_PASSWORD=app_job_dev
DATABASE_URL_JOB=postgres://app_job:app_job_dev@localhost:5432/admin_barrios

# --- MinIO / S3-compatible (almacenamiento, ver ADR §3.3) ---
# En AWS: reemplazar por credenciales de S3 real. En Supabase: por el endpoint S3-compatible
# de Supabase Storage. El cliente (@aws-sdk/client-s3) es el mismo en los tres casos.
MINIO_ROOT_USER=admin_barrios
MINIO_ROOT_PASSWORD=admin_barrios_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=admin-barrios
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=admin_barrios
S3_SECRET_ACCESS_KEY=admin_barrios_dev
S3_BUCKET=admin-barrios
S3_FORCE_PATH_STYLE=true

# --- Auth (ver ADR §3.2) ---
# Adapter concreto todavía no decidido (depende del hosting final). Placeholder hasta Fase 6B/6C.
AUTH_PROVIDER=                     # supabase | cognito | gotrue-self-hosted

# --- App ---
NODE_ENV=development
APP_TIMEZONE=America/Argentina/Cordoba
