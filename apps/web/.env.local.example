# ============================================================
# admin-barrios — variables de la WEB DEL ADMINISTRADOR (`pnpm dev` en el host)
#
# Copiar a `apps/web/.env.local`. Next carga este archivo, no el `.env` de la raíz.
#
# ESTA ES LA LISTA COMPLETA. No es un recorte por comodidad: es la lista de permitidos del proceso
# `web` (tools/infra/credenciales.ts). Si acá aparece `DATABASE_URL` (dueño del esquema) o
# `DATABASE_URL_JOB` (BYPASSRLS), las policies de la base dejan de evaluarse y el aislamiento entre
# barrios —que es todo el trabajo de las migraciones de RLS— vale cero.
#
# El guard lo verifica al arrancar: `pnpm dev` lee este archivo y se niega a levantar si encuentra
# una credencial que no le toca. NUNCA copiar el `.env` de la raíz acá.
# ============================================================

# local | staging | produccion. Obligatoria y sin default: lo que no está declarado explícitamente
# como desarrollo se trata como producción. Con cualquier valor distinto de `local`, el sustituto de
# identidad de desarrollo no se habilita (ADR-0002 §2.4).
APP_ENTORNO=local
APP_TIMEZONE=America/Argentina/Cordoba

# La ÚNICA conexión a la base que recibe la web: el rol `app_request`, sujeto a RLS.
DATABASE_URL_APP=postgres://app_request_dev:app_request_dev@localhost:5432/admin_barrios

# Techo del pool de este proceso. Opcional: sin ella, 10 (ADR-0002 §3.3). Dos instancias × 10 = 20,
# muy por debajo de las 100 conexiones que Postgres 16 admite por defecto. En serverless un pool por
# instancia NO sirve: hace falta un pooler externo y bajar esto a 1.
# APP_DB_MAX_CONEXIONES=10

# El adapter de identidad. `dev-suplantacion` es el sustituto de desarrollo y solo se habilita con
# APP_ENTORNO=local; con cualquier otro valor la fábrica LANZA y el proceso no atiende. Aun
# habilitado, no puede suplantar a nadie si la tabla `usuario_demo` está vacía — que es lo que pasa
# en cualquier base donde no haya corrido `pnpm db:seed` (ADR-0002 §2.4).
AUTH_PROVIDER=dev-suplantacion

# Storage: cuenta de solo lectura (la web firma URLs de descarga; escribir es del worker).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=admin-barrios
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=app_web_dev
S3_SECRET_ACCESS_KEY=app_web_dev_secret
