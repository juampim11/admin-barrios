# ============================================================
# admin-barrios — variables de entorno de la INFRAESTRUCTURA LOCAL
#
# Este archivo se copia a `.env` (raíz). Lo leen tres cosas, y ninguna de ellas atiende usuarios:
#   - `docker compose`, para armar el entorno de cada contenedor (a cada uno le pasa solo lo suyo);
#   - los scripts de base (`pnpm db:migrate`, `db:setup`, `db:seed`), que corren como dueño del esquema;
#   - `vitest`, para los tests contra Postgres real.
#
# La WEB NO LEE ESTE ARCHIVO. Sus variables van en `apps/web/.env.local` — ver
# `apps/web/.env.local.example`. La separación no es orden: es el cerrojo. Copiar este archivo a
# `apps/web/.env.local` le entrega a la web la conexión del dueño del esquema y la del rol que saltea
# la RLS, y con eso el aislamiento entre barrios deja de existir (docs/devops/01-entornos.md §2.1).
#
# NUNCA se commitea `.env` ni `.env.local`. Los valores de acá son de DESARROLLO y no valen en
# ningún otro lado: cada entorno genera los suyos (§2.3 del mismo documento).
# ============================================================

# --- Qué entorno es este --------------------------------------------------
# local | staging | produccion. Obligatoria y SIN default en el código: lo que no está declarado
# explícitamente como desarrollo se trata como producción. Es lista de permitidos, no de prohibidos.
# No se usa `NODE_ENV` para esto: `NODE_ENV` dice cómo se compila (hay motivos legítimos para correr
# un entorno real con `NODE_ENV=development`), no en qué entorno se está corriendo.
APP_ENTORNO=local
APP_TIMEZONE=America/Argentina/Cordoba

# --- Postgres (datos, ver ADR-0000 §3.1) ----------------------------------
# Credenciales del contenedor local. El puerto se publica solo en 127.0.0.1.
POSTGRES_DB=admin_barrios
POSTGRES_USER=admin_barrios
POSTGRES_PASSWORD=admin_barrios_dev
POSTGRES_PORT=5432

# DUEÑO DEL ESQUEMA — migraciones y scripts locales, nada más. Ningún proceso que atienda usuarios
# la recibe: ni la web ni el worker. Puede hacer DDL y escribir cualquier tabla.
DATABASE_URL=postgres://admin_barrios:admin_barrios_dev@localhost:5432/admin_barrios

# ROL DE REQUEST (`app_request`) — SUJETO A RLS. Es la única conexión que puede atender a una persona,
# y solo a través de `conUsuario()`. Se crea localmente con `pnpm db:setup` (los roles nacen sin
# contraseña en la migración: un secreto nunca va al repo).
APP_DB_USER=app_request_dev
APP_DB_PASSWORD=app_request_dev
DATABASE_URL_APP=postgres://app_request_dev:app_request_dev@localhost:5432/admin_barrios

# ROL DE JOBS (`app_job`) — BYPASSRLS: las policies no se evalúan. Lo recibe SOLO el worker, y solo
# para tomar el trabajo de la cola; el trabajo real corre con la identidad de quien lo pidió.
JOB_DB_PASSWORD=app_job_dev
DATABASE_URL_JOB=postgres://app_job:app_job_dev@localhost:5432/admin_barrios

# --- MinIO / S3-compatible (almacenamiento, ver ADR-0000 §3.3) ------------
# En AWS: S3 real con dos políticas de IAM. En Supabase: el endpoint S3-compatible. El cliente
# (@aws-sdk/client-s3) es el mismo en los tres casos.

# Cuenta de ADMINISTRACIÓN del storage. La usa el contenedor de MinIO y la consola. Ninguna
# aplicación la recibe: puede borrar buckets enteros.
MINIO_ROOT_USER=admin_barrios
MINIO_ROOT_PASSWORD=admin_barrios_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=admin-barrios

# MinIO ignora la región, pero el cliente de S3 LANZA si no la recibe — y en AWS o en el endpoint
# compatible de Supabase es un valor real. Se declara siempre.
S3_REGION=us-east-1

# Cuentas de servicio que crea `pnpm db:up`. La web solo lee (firma URLs de descarga); el worker
# escribe los documentos emitidos.
S3_WEB_ACCESS_KEY_ID=app_web_dev
S3_WEB_SECRET_ACCESS_KEY=app_web_dev_secret
S3_WORKER_ACCESS_KEY_ID=app_worker_dev
S3_WORKER_SECRET_ACCESS_KEY=app_worker_dev_secret

# --- Auth (ver ADR-0000 §3.2 y ADR-0002 §2) -------------------------------
# `dev-suplantacion` es el sustituto de desarrollo: se habilita SOLO con APP_ENTORNO=local, y aun así
# no puede suplantar a nadie si la tabla del elenco de la demo está vacía.
AUTH_PROVIDER=dev-suplantacion   # dev-suplantacion | supabase | cognito | gotrue-self-hosted

# --- El worker que genera los documentos (ver ADR-0002 §6.3) --------------
# Cuántas boletas por pasada del navegador. **50 es un número medido** (ADR-0001 §3.2): con chunk de
# 50 el techo de memoria queda en ~520 MB. Subirlo sube la memoria, no la velocidad.
APP_WORKER_CHUNK=50
APP_WORKER_TIMEOUT_MS=120000
# Cada cuánto barre la cola buscando rezagados. El disparo normal es `pg_notify` (latencia de
# milisegundos, cero polling); esto es solo la red de seguridad, y en un día normal no encuentra nada.
APP_WORKER_INTERVALO_MS=60000

# --- Job runner (ver docs/devops/03-reglas-desarrollo-optimizado.md §5) ---
# Secreto que autentica el disparo de un job desde afuera (cron del SO, EventBridge, K8s CronJob).
# DISTINTO por entorno, a propósito: un disparo de local no tiene que servir contra staging.
# Generá el tuyo: `node -e "console.log(crypto.randomUUID())"`.
CRON_SECRET=cambiar-por-uno-propio-de-esta-maquina

# --- Puerto de la web -----------------------------------------------------
# 4000 y no 3000: el 3000 está ocupado por otro proyecto de la máquina.
WEB_PORT=4000
