# ============================================================
# apps/worker — variables del PROCESO QUE GENERA LOS DOCUMENTOS
#
# Se copia a `apps/worker/.env.local`. **NO copiar acá el `.env` de la raíz**: ahí vive
# `DATABASE_URL`, el dueño del esquema, y este proceso no tiene ningún motivo para poder hacer DDL.
# El guard de arranque aborta si la encuentra, y "arreglarlo" agregándola a la lista de permitidos
# sería deshacer el cerrojo (docs/devops/01-entornos.md §2.1).
#
# Esta es la lista COMPLETA de lo que le toca al rol `worker`, declarada en
# `tools/infra/credenciales.ts` y verificada en el gate de CI.
# ============================================================

APP_ENTORNO=local
APP_TIMEZONE=America/Argentina/Cordoba

# --- Las DOS conexiones, y para qué es cada una ---------------------------
# El worker es el único proceso que legítimamente tiene las dos, y la diferencia es todo el diseño:
#
#   · `DATABASE_URL_JOB`  (app_job, BYPASSRLS) — SOLO para tomar una fila de la cola y moverle el
#     estado. Nada más pasa por acá.
#   · `DATABASE_URL_APP`  (app_request, sujeto a RLS) — con esta corre TODO el trabajo real, con la
#     identidad de quien apretó el botón (ADR-0002 §6.4). Si a esa persona le revocaron la membresía
#     entre el encolado y la corrida, el trabajo falla, y está bien: falla cerrado.
DATABASE_URL_JOB=postgres://app_job:app_job_dev@localhost:5432/admin_barrios
DATABASE_URL_APP=postgres://app_request_dev:app_request_dev@localhost:5432/admin_barrios

# --- Almacenamiento: la cuenta de ESCRITURA ------------------------------
# Distinta de la de la web, que solo lee. Es el espejo barato de lo que en un entorno real son dos
# políticas de IAM.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=admin-barrios
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=app_worker_dev
S3_SECRET_ACCESS_KEY=app_worker_dev_secret

# --- Cómo trabaja --------------------------------------------------------
APP_WORKER_CHUNK=50
APP_WORKER_TIMEOUT_MS=120000
APP_WORKER_INTERVALO_MS=60000

# --- El navegador --------------------------------------------------------
# En el host, el Chrome que ya tenés instalado. En el contenedor del perfil `worker` lo pone el
# compose (`/usr/bin/chromium`), que es el Chromium fijado de la imagen.
#
# Ojo con la diferencia, que es real y conviene saberla: tu Chrome de Windows se actualiza solo y
# mide el texto distinto que el de la imagen, así que un PDF hecho en tu máquina no es byte a byte
# idéntico al de producción. No es un problema —la correctitud del dinero se verifica en el modelo de
# vista y en el HTML, nunca contra píxeles— y cada documento emitido guarda en qué motor se hizo.
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
